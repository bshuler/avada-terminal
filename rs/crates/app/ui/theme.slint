// Shared theme tokens + small reusable chrome widgets for the avada shell.
//
// The values written here are the Avada brand palette — Void Black ground, Spell Green
// (left/active energy) as the accent, Arcane Purple (AI/right energy) as the second accent
// — but they are only the *defaults*. Every one of them is `in-out` because the controller
// overwrites the whole set from `theme::UI_PALETTES` on startup and whenever the user picks
// another palette (`state::Setting::UiPalette`); a `out property` would have made the
// picker impossible.
//
// Two rules keep a palette swap total:
//   * no colour is written anywhere but here — a literal hex elsewhere is a token that
//     stops changing when the palette does, which is worse than an imperfect token;
//   * the aliases at the bottom stay plain `out`, so they keep tracking the token they
//     were derived from instead of being frozen by a Rust setter that forgot them.
//
// Exactly two literals survive elsewhere, and both are deliberate: the eight project
// swatch hues in `sidebar.slint` (a user's chosen label colour, not a theme token — they
// are the brand's Avada frame palette, slot for slot with `theme::AVADA_FRAME`), and
// Soft White `#f5f5f5` where it is ink sitting on a saturated `danger` fill — light ink on
// red is the right answer on every palette, so deriving it from one would only make it
// wrong. Every colour traces to docs/brand/design-requirements.md; see
// docs/brand/color-audit.md for the one non-brand hue (`danger`) and why it stays.

export global Theme {
    // surfaces
    in-out property <color> bg: #000000;        // --avada-bg (pane area + active tab)
    in-out property <color> mantle: #050507;    // --avada-mantle (top bar)
    in-out property <color> surface: #0b0b10;   // --avada-surface (tab hover)
    in-out property <color> surface2: #15151d;  // --avada-surface2 (hover / chips)
    in-out property <color> border: #26262f;    // --avada-border
    // ink
    in-out property <color> text: #f5f5f5;       // --avada-text
    in-out property <color> subtext: #a0a0a0;    // --avada-subtext
    in-out property <color> faint: #6e6e78;
    // accent — Spell Green: left/active energy (never the AI colour)
    in-out property <color> accent: #39ff14;     // --avada-accent
    // accent2 — Arcane Purple: AI/right energy (never the active colour)
    in-out property <color> accent2: #7b2cbf;    // --avada-accent2
    in-out property <color> danger: #e5484d;     // window close hover
    in-out property <color> ok: #3ec46d;         // a finished/healthy state (agent liveness)
    in-out property <color> warn: #d4af37;       // a state wanting attention (agent awaiting input)
    // A link inside rendered markdown. Distinct from `accent`, which headings
    // already use — a heading that looks clickable is a lie.
    in-out property <color> link: #5fe0a0;
    in-out property <color> scrim: #0000008c;
    // The wash drawn over the whole window behind a modal. Separate from `scrim`,
    // which is only ever a drop-shadow colour — a backdrop wants far more opacity
    // than a shadow does, and on a light palette the two want different hues.
    in-out property <color> veil: #000000cc;

    // ---- "Arcane" chrome (center column + titlebar only; the rails keep the palette) ----
    // Fixed, not palette-swapped: the Arcane look is a deliberate identity for the terminal
    // surface and its title bar, so a shell palette pick does not repaint it. The side
    // rails never read these.
    out property <color> arc-bg: #0a0a0f;       // near-black ground of the center column
    out property <color> arc-bar: #0d0d14;      // titlebar ground, a step above arc-bg
    out property <color> arc-gold: #e8b84b;     // titles, headers
    out property <color> arc-magenta: #c23ae0;  // accent rules, glyphs
    out property <color> arc-green: #3ee07a;    // prompt arrow, OK status
    out property <color> arc-lavender: #9a98b5; // labels, body
    out property <color> arc-rule: #3a2a55;     // dividers

    // ---- aliases kept for the rest of the UI (paneview/app) ----
    out property <color> brand: self.accent;
    out property <color> ink: self.text;
    out property <color> ink-dim: self.subtext;
    out property <color> ink-faint: self.faint;
    out property <color> hover: self.surface2;
}
