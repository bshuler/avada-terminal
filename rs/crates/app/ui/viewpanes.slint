// The Family B (non-PTY) pane body: one component that renders the file browser,
// the file viewer and the markdown preview.
//
// There is deliberately no parsing here. `src/viewpane.rs` turns the pane's target
// path into a flat `[PaneViewRow]` where `role` already says how each row should
// look; this file only maps role → styling. That is what lets three quite
// different-looking views share ~150 lines instead of three renderers, and it
// keeps every decision (sort order, truncation, "is this binary?") in Rust where
// it is unit-tested.

import { Theme } from "theme.slint";
import { PaneViewRow } from "types.slint";
import { ListView } from "std-widgets.slint";
// Registers the family "JetBrains Mono" so a source row can ask for it by name. The
// same file `prefs::BUNDLED_FONTS` extracts for the terminal, imported again here
// because the terminal's font goes through our own texture renderer, not Slint's —
// there is no shared handle between the two.
import "../assets/fonts/JetBrainsMono-Regular.ttf";

// The leading mark for a listing row. Drawn geometry, never a font glyph — the
// same rule the menu icons follow (a missing codepoint renders as a hollow box on
// Windows).
component RowMark inherits Rectangle {
    in property <int> role;
    in property <color> ink;
    // Drawn, not glyphed, so nothing scales it for free — every measurement below is
    // multiplied by hand. See `ViewRowView::zoom`.
    in property <float> zoom: 1.0;

    width: 12px * root.zoom;
    height: 12px * root.zoom;

    // a folder: a body with a raised tab on its leading edge
    if root.role == 0 || root.role == 1 : Rectangle {
        Rectangle {
            x: 0; y: 2px * root.zoom;
            width: 5px * root.zoom; height: 2px * root.zoom;
            background: root.ink;
            border-radius: 1px * root.zoom;
        }
        Rectangle {
            x: 0; y: 3.5px * root.zoom;
            width: 12px * root.zoom; height: 7.5px * root.zoom;
            background: root.ink;
            border-radius: 1.5px * root.zoom;
        }
    }

    // a page: a sheet with its top-trailing corner folded away
    if root.role == 2 : Rectangle {
        Rectangle {
            x: 1.5px * root.zoom; y: 1px * root.zoom;
            width: 9px * root.zoom; height: 10px * root.zoom;
            background: root.ink;
            border-radius: 1.5px * root.zoom;
        }
        // the fold, punched out in the pane's own background
        Rectangle {
            x: 7.5px * root.zoom; y: 0.5px * root.zoom;
            width: 3.5px * root.zoom; height: 3.5px * root.zoom;
            background: Theme.bg;
        }
    }
}

// One projected row. Every `role` lands here; an unrecognised one falls through to
// the plain-line style rather than disappearing, so a newer Rust side can add a
// role without this file going blank.
component ViewRowView inherits Rectangle {
    in property <PaneViewRow> item;
    in property <color> accent;
    // Cmd+= / Cmd+- / Cmd+0. The multiplier the pane derives from its own `font-px`, so a
    // view pane answers the zoom chords the same way a terminal pane does — the chord was
    // always reaching Rust, and the focused pane's `font_px` was always projected here; it
    // was only this half of the app that never read it.
    //
    // Applied by hand rather than by a transform because Slint has none for a subtree: a
    // row is absolute positions and hard-coded sizes, and every one of them has to be told.
    // The exception is a mermaid diagram (role 12), whose box was measured Rust-side in
    // `src/mermaid.rs` — scaling the frame without the layout inside it would only crop it,
    // so a diagram keeps its own size and the prose around it grows past it.
    in property <float> zoom: 1.0;
    // Inside the pane's selected row range: paints the highlight.
    in property <bool> selected;
    callback activate();
    // The human picked this row. `extend` is a shift-click — stretch the existing
    // selection to reach here instead of starting a new one.
    callback select(bool);
    // A link inside rendered markdown. Reported as the href, not the row: the
    // controller opens it through the same browser-choice path an OSC 8 link in a
    // terminal pane takes, so one preference governs both.
    callback link-clicked(string);

    // Prose, list items and quotes are a run of inline markdown that wraps, so
    // their height is whatever the renderer needs *at this width* — the one
    // measurement this side can't make, since the UI font is proportional.
    property <bool> flows: root.item.role == 16 || root.item.role == 8 || root.item.role == 9;
    property <bool> heads: root.item.role >= 4 && root.item.role <= 6;
    // Where the text column starts. A list item steps in by its nesting; the
    // gutter to its left holds the dot, the ordinal or the task box.
    property <length> lead: (root.item.role == 8 ? 24px + root.item.indent * 14px
        : root.item.role == 9 ? 16px
        : 8px) * root.zoom;

    // A rule is a divider, not a line of text; a blank line is air. A diagram
    // sizes itself: its height was decided by the layout in `src/mermaid.rs`, and
    // nothing here may second-guess it.
    //
    // A flowing row adds NO padding, and that is the whole fix for a complaint that
    // wrapped lines "encroach on the line above". Slint 1.17 has no `line-height` on
    // `Text` or `StyledText`: the pitch *inside* a wrapped run is pinned to the requested
    // font's own line box (`textlayout/sharedparley.rs` — (ascent − descent + leading) /
    // upem, which is 1.178 em for the macOS system font, so 14.1px at 12px) and nothing
    // declarable here can loosen it. Any padding a row adds lands *between* rows only, so
    // every pixel of it widens the gap between two blocks while the gap inside a wrapped
    // block stays put — and a continuation line sitting tighter than the rhythm its
    // neighbours just established is precisely what reads as creeping upward. Since the
    // inner pitch cannot be raised, the outer one is brought down to meet it: row height
    // *is* the text's height, so one pitch governs the whole column.
    //
    // The air a document wants then comes from the places that asked for it — the
    // blank-line rows (role 15) between paragraphs, and the heading padding below — rather
    // than from a uniform tax on every line.
    // The flowing and heading rows measure themselves, so they follow the font size on
    // their own; the fixed ones are told. A diagram's height came from Rust and stays.
    height: root.item.role == 12 ? root.item.diagram.h + 12px
        : root.item.role == 10 ? 15px * root.zoom
        : root.item.role == 15 ? 7px * root.zoom
        : root.item.role == 13 || root.item.role == 14 ? 24px * root.zoom
        : root.flows ? max(14px * root.zoom, flow.preferred-height)
        : root.heads ? max(22px * root.zoom, head.preferred-height + 8px * root.zoom)
        : 19px * root.zoom;
    // Selection wins over hover: while a range is highlighted, the pointer moving
    // across it must not make one row of it look different from the rest.
    background: root.selected ? root.accent.with-alpha(0.22)
        : ta.has-hover && root.item.activatable ? Theme.text.with-alpha(0.07)
        : transparent;

    // What a screen reader — or a test — can call this row.
    //
    // The row *is* the control: `ta` covers it, and a click here opens a file, walks
    // into a directory, or extends the selection. Everything visible in it, though, is
    // a child Text, which Slint auto-labels — so the row looked named while the element
    // the click actually lands on announced nothing at all.
    //
    // `text` holds the raw source line for every role that has one (prose keeps it
    // beside the parsed `md`), so a single binding covers listings, headings, code,
    // notices and paragraphs alike. The exceptions are the three rows that draw no
    // text of their own.
    property <string> a11y: root.item.role == 15 ? ""
        : root.item.role == 10 ? "Horizontal rule"
        : root.item.role == 12 ? "Diagram"
        // Two identical lines of a file are two different rows, and the viewer already
        // prints the number that tells them apart.
        : root.item.role == 3 || (root.item.role > 16 && root.item.role != 18)
            ? "Line " + root.item.detail + ": " + root.item.text
        : root.item.text;

    accessible-role: list-item;
    accessible-label: root.a11y;
    // A data node (role 18) folds. Its `check` is the disclosure: -1 a scalar, 0 folded,
    // 1 open — so only a container is expandable, and a scalar reads as a plain item.
    accessible-expandable: root.item.role == 18 && root.item.check >= 0;
    accessible-expanded: root.item.role == 18 && root.item.check == 1;
    // The dim trailing column — a size and an age in a listing. It elaborates the name
    // rather than being part of it, which is the whole distinction between a
    // description and a label.
    accessible-description: root.item.role <= 2 ? root.item.detail : "";
    // Selection is a range here, not a cursor, so every row is a candidate and the
    // highlight is the only thing that says which ones are in it.
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    // The same fork the click takes: an openable row opens, an inert one selects.
    accessible-action-default => {
        if (root.item.activatable) {
            root.activate();
        } else {
            root.select(false);
        }
    }

    ta := TouchArea {
        // A row you can open reads as a link; a row you can only select reads as
        // text, which is exactly what it now is.
        mouse-cursor: root.item.activatable ? pointer : text;
        // Shift is captured on the press because `clicked` does not carry the
        // modifiers (same pattern as the sidebar's shift-range select).
        property <bool> shift;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.shift = e.modifiers.shift; }
        }
        clicked => {
            // A plain click on an openable row still opens it — that gesture was
            // there first and is what a file browser is for. Shift-click is the
            // way to select one of those instead, and on an inert row (a line of
            // a file, a paragraph of a preview) a plain click already selects.
            if (root.item.activatable && !self.shift) {
                root.activate();
            } else {
                root.select(self.shift);
            }
        }
    }

    // Declared here, not inside their `if` branches: a name scoped to a branch is
    // invisible to the row's own height binding. `ListView` only builds the rows
    // on screen, so the pair costs ~40 idle elements, not 5,000.
    flow := StyledText {
        x: root.lead;
        // Flush: the row is exactly as tall as the text, so there is nothing to split.
        y: 0;
        width: root.width - root.lead - 8px;
        visible: root.flows;
        // Empty on every non-flowing role, which is what keeps a 2,000-character
        // source line out of the text shaper.
        text: root.item.md;
        default-color: root.item.role == 9 ? Theme.subtext : Theme.text;
        default-font-size: 12px * root.zoom;
        link-color: Theme.link;
        link-clicked(l) => { root.link-clicked(l); }
    }
    head := Text {
        x: 8px * root.zoom;
        y: 4px * root.zoom;
        width: root.width - 16px * root.zoom;
        visible: root.heads;
        // A heading is a plain Text because it needs a font weight, and
        // `StyledText` has no property for one — so its markers were stripped
        // Rust-side instead.
        text: root.heads ? root.item.text : "";
        wrap: word-wrap;
        color: root.item.role == 4 ? root.accent : Theme.text;
        font-size: (root.item.role == 4 ? 17px : root.item.role == 5 ? 14px : 12px) * root.zoom;
        font-weight: 700;
    }

    // --- 10: horizontal rule ---
    if root.item.role == 10 : Rectangle {
        x: 6px;
        y: (parent.height - 1px) / 2;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.border;
    }

    // --- 9: block quote — the bar; the text is `flow`, dimmed ---
    if root.item.role == 9 : Rectangle {
        x: 6px * root.zoom; y: 2px * root.zoom;
        width: 2px * root.zoom; height: parent.height - 4px * root.zoom;
        background: Theme.surface2;
    }

    // --- 7: code — the row gets its own darker ground so a block reads as one ---
    if root.item.role == 7 : Rectangle {
        background: Theme.text.with-alpha(0.06);
        Text {
            x: 12px * root.zoom;
            width: parent.width - 18px * root.zoom;
            height: 100%;
            vertical-alignment: center;
            text: root.item.text;
            color: Theme.text;
            font-size: 12px * root.zoom;
            overflow: elide;
        }
    }

    // --- 8: list item — the gutter only; the text is `flow`.
    // A dot, an ordinal or a task box, all drawn: "•" and "☑" are font glyphs,
    // and a missing codepoint renders as a hollow box on Windows.
    if root.item.role == 8 && root.item.check < 0 && root.item.marker == "" : Rectangle {
        x: root.lead - 12px * root.zoom;
        // Each gutter mark tracks `flow.y`: they line up with the item's *first* line, not
        // with the row box, which grows downward as the item wraps.
        y: 5px * root.zoom;
        width: 3px * root.zoom; height: 3px * root.zoom;
        border-radius: 1.5px * root.zoom;
        background: Theme.subtext;
    }
    if root.item.role == 8 && root.item.check < 0 && root.item.marker != "" : Text {
        // Right-aligned so "9." and "10." share an edge instead of ragging.
        x: 0;
        width: root.lead - 6px * root.zoom;
        y: 0;
        horizontal-alignment: right;
        text: root.item.marker;
        color: Theme.subtext;
        font-size: 12px * root.zoom;
    }
    if root.item.role == 8 && root.item.check >= 0 : Rectangle {
        x: root.lead - 15px * root.zoom;
        y: 1px * root.zoom;
        width: 11px * root.zoom; height: 11px * root.zoom;
        border-radius: 2px * root.zoom;
        border-width: 1px * root.zoom;
        border-color: root.item.check == 1 ? Theme.ok : Theme.faint;
        background: root.item.check == 1 ? Theme.ok.with-alpha(0.18) : transparent;
        // The tick, stroked rather than glyphed, for the same reason as the dot.
        if root.item.check == 1 : Path {
            x: 2px * root.zoom; y: 2px * root.zoom;
            width: 7px * root.zoom; height: 7px * root.zoom;
            // The viewbox is unitless and the path is drawn in it, so the SVG scales with
            // the box above on its own — only the stroke is in screen px.
            viewbox-width: 7;
            viewbox-height: 7;
            commands: "M 0.4 3.5 L 2.6 5.8 L 6.6 1.1";
            stroke: Theme.ok;
            stroke-width: 1.5px * root.zoom;
            fill: transparent;
        }
    }

    // --- 11: notice — the app talking, not the file ---
    if root.item.role == 11 : Text {
        x: 8px * root.zoom;
        width: parent.width - 14px * root.zoom;
        height: 100%;
        vertical-alignment: center;
        text: root.item.text;
        color: Theme.faint;
        font-italic: true;
        font-size: 11px * root.zoom;
        overflow: elide;
    }

    // --- 0/1/2: a listing row — mark, name, and a dim trailing detail column ---
    if root.item.role <= 2 : HorizontalLayout {
        padding-left: 8px * root.zoom;
        padding-right: 8px * root.zoom;
        spacing: 7px * root.zoom;
        VerticalLayout {
            alignment: center;
            RowMark {
                role: root.item.role;
                zoom: root.zoom;
                // ".." and directories take the accent so the navigable rows read
                // as a group; files stay dim.
                ink: root.item.role == 2 ? Theme.faint : root.accent;
            }
        }
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.item.text;
            color: root.item.role == 2 ? Theme.text : Theme.text;
            font-weight: root.item.role == 2 ? 400 : 600;
            font-size: 12px * root.zoom;
            overflow: elide;
        }
        Text {
            vertical-alignment: center;
            text: root.item.detail;
            color: Theme.faint;
            font-size: 10px * root.zoom;
        }
    }

    // --- 12: a mermaid diagram, laid out Rust-side and drawn absolutely ---
    if root.item.role == 12 : Rectangle {
        clip: true;
        // A diagram wider than the pane pans instead of clipping. The viewport is
        // pinned to the row's own height so a horizontal drag can never fight the
        // enclosing ListView for the vertical gesture.
        Flickable {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            viewport-width: max(root.item.diagram.w, self.width);
            viewport-height: self.height;

            // Everything sits inside one canvas sized to the diagram itself. A
            // Path stretches to fill its parent whatever its own width says, so
            // this box is what makes that stretch the identity transform and
            // keeps the strokes in the same coordinate space as the nodes.
            Rectangle {
            x: 0px;
            y: 0px;
            width: root.item.diagram.w;
            height: root.item.diagram.h;

            // Strokes first, so every node paints over its own edges.
            Path {
                width: root.item.diagram.w;
                height: root.item.diagram.h;
                viewbox-width: root.item.diagram.w / 1px;
                viewbox-height: root.item.diagram.h / 1px;
                commands: root.item.diagram.lines;
                stroke: Theme.subtext;
                stroke-width: 1.3px;
                fill: transparent;
            }
            Path {
                width: root.item.diagram.w;
                height: root.item.diagram.h;
                viewbox-width: root.item.diagram.w / 1px;
                viewbox-height: root.item.diagram.h / 1px;
                commands: root.item.diagram.dashed;
                stroke: Theme.faint;
                stroke-width: 1.3px;
                fill: transparent;
            }
            Path {
                width: root.item.diagram.w;
                height: root.item.diagram.h;
                viewbox-width: root.item.diagram.w / 1px;
                viewbox-height: root.item.diagram.h / 1px;
                commands: root.item.diagram.thick;
                stroke: root.accent;
                stroke-width: 2.4px;
                fill: transparent;
            }
            Path {
                width: root.item.diagram.w;
                height: root.item.diagram.h;
                viewbox-width: root.item.diagram.w / 1px;
                viewbox-height: root.item.diagram.h / 1px;
                commands: root.item.diagram.heads;
                stroke: transparent;
                fill: Theme.subtext;
            }
            // Diamonds are the one shape a Rectangle cannot be, so they arrive as
            // a filled path and skip the box below.
            Path {
                width: root.item.diagram.w;
                height: root.item.diagram.h;
                viewbox-width: root.item.diagram.w / 1px;
                viewbox-height: root.item.diagram.h / 1px;
                commands: root.item.diagram.diamonds;
                stroke: root.accent.with-alpha(0.65);
                stroke-width: 1.2px;
                fill: Theme.surface;
            }

            for nd in root.item.diagram.nodes : Rectangle {
                x: nd.x;
                y: nd.y;
                width: nd.w;
                height: nd.h;
                // shape 2 (diamond) is already drawn by the path above.
                background: nd.shape == 2 ? transparent : Theme.surface;
                border-color: nd.shape == 2 ? transparent : root.accent.with-alpha(0.65);
                border-width: nd.shape == 2 ? 0px : 1.2px;
                // 1 = rounded/stadium, 3 = circle: both are a box whose radius is
                // half its shorter side.
                border-radius: nd.shape == 1 || nd.shape == 3 ? nd.h / 2 : 4px;
                Text {
                    x: 6px;
                    width: parent.width - 12px;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: nd.text;
                    color: Theme.text;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            // Labels last and over their own ground, so an edge never runs through
            // the text that describes it.
            for lb in root.item.diagram.labels : Rectangle {
                x: lb.x;
                y: lb.y;
                width: lb.w;
                height: 15px;
                background: Theme.bg;
                border-radius: 3px;
                Text {
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: lb.text;
                    color: Theme.subtext;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            }
        }
    }

    // --- 13/14: table — a rule under the header ---
    // Two tables share this block. A markdown table (`detail` empty) shares the width
    // out evenly. A CSV/TSV grid (`detail` = its record number, set by
    // `viewpane::table_rows`) draws every cell at its own content width in the
    // monospace face — the cells arrive padded to their column's width, so they line
    // up the way `column -t` lines them up — behind a row-number gutter, with the
    // overflow clipped rather than wrapped: row N stays one row tall. Body rows
    // alternate a faint stripe. `cell` is reachable by element id; a `StyledText`
    // cannot label itself from a `styled-text`, so the row's own label (`text`, the
    // verbatim cells) is what a screen reader announces.
    if root.item.role == 13 || root.item.role == 14 : tbl := Rectangle {
        property <bool> grid: root.item.detail != "";
        property <bool> striped: tbl.grid && Math.mod(root.item.detail.to-float(), 2) == 0;
        clip: tbl.grid;
        background: root.item.role == 13 ? Theme.text.with-alpha(0.03)
            : tbl.striped ? Theme.text.with-alpha(0.02)
            : transparent;
        HorizontalLayout {
            padding-left: 8px * root.zoom;
            padding-right: 8px * root.zoom;
            spacing: 10px * root.zoom;
            if tbl.grid : Text {
                width: 34px * root.zoom;
                text: root.item.detail;
                color: Theme.faint;
                font-size: 10px * root.zoom;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            for c in root.item.cells : cell := StyledText {
                horizontal-stretch: tbl.grid ? 0 : 1;
                vertical-alignment: center;
                horizontal-alignment: c.align == 1 ? center : c.align == 2 ? right : left;
                text: c.md;
                default-color: root.item.role == 13 ? root.accent : Theme.text;
                default-font-family: tbl.grid ? "JetBrains Mono" : "";
                default-font-size: 12px * root.zoom;
                link-color: Theme.link;
                link-clicked(l) => { root.link-clicked(l); }
            }
            // Eats the slack so a grid's cells keep their natural width.
            if tbl.grid : Rectangle { horizontal-stretch: 1; }
        }
        if root.item.role == 13 : Rectangle {
            x: 8px;
            y: parent.height - 1px;
            width: parent.width - 16px;
            height: 1px;
            background: Theme.border;
        }
    }

    // --- 3 (and anything unknown): a verbatim line, with the viewer's line
    // number. Verbatim is the point: row N has to stay line N, so this one
    // elides where prose wraps, and its `*`s are asterisks, not emphasis.
    // --- 17: a source line, syntax-coloured. The same shape as role 3, because the
    // gutter numbers of the two have to form one column, but the body is a
    // `StyledText` carrying the markup `highlight::markup_lines` built, and it is
    // monospaced: a proportional font would throw away every alignment the file
    // itself is relying on. `StyledText` has no `overflow`, so the clip is the
    // wrapper's job — a long line must not grow the row, or row N stops being line N.
    if root.item.role == 17 : Rectangle {
        clip: true;
        HorizontalLayout {
            padding-left: 6px * root.zoom;
            padding-right: 8px * root.zoom;
            spacing: 8px * root.zoom;
            Text {
                width: 34px * root.zoom;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.item.detail;
                color: Theme.faint;
                font-size: 10px * root.zoom;
            }
            src := StyledText {
                vertical-alignment: center;
                // `md`, not `text`: `text` stays the raw line, for copy and the
                // accessible label. See `viewpane::ViewRow::markup`.
                text: root.item.md;
                default-color: Theme.text;
                default-font-family: "JetBrains Mono";
                default-font-size: 12px * root.zoom;
            }
            // The source line takes its natural width and this eats the rest. A
            // `horizontal-stretch` on the text would have been shorter, but then the
            // element's width would be the pane's rather than the glyphs' — and the
            // glyphs' width is the only thing a test can measure the font by.
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // ---- V1 data tree
    // A node of a data pane: a disclosure glyph, the key (or `key: value`) inked by
    // type, and on a folded container the count of what it hides. Depth is `indent`,
    // paid as left padding so the tree reads as one. Fixed height: row N is node N.
    if root.item.role == 18 : Rectangle {
        clip: true;
        HorizontalLayout {
            padding-left: (6px + 14px * root.item.indent) * root.zoom;
            padding-right: 8px * root.zoom;
            spacing: 6px * root.zoom;
            // Decoration only: it is not in `text`, so a copy or a screen reader never
            // meets it. A scalar keeps the column so its key lines up with a sibling's.
            disclosure := Text {
                width: 12px * root.zoom;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.item.check == 1 ? "▾" : root.item.check == 0 ? "▸" : "";
                color: Theme.subtext;
                font-size: 11px * root.zoom;
            }
            node := StyledText {
                vertical-alignment: center;
                text: root.item.md;
                default-color: Theme.text;
                default-font-family: "JetBrains Mono";
                default-font-size: 12px * root.zoom;
            }
            if root.item.check == 0 : Text {
                vertical-alignment: center;
                text: root.item.detail;
                color: Theme.faint;
                font-size: 10px * root.zoom;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    if root.item.role == 3 || root.item.role > 18 : HorizontalLayout {
        padding-left: 6px * root.zoom;
        padding-right: 8px * root.zoom;
        spacing: 8px * root.zoom;
        Text {
            // A fixed gutter so the numbers form a column instead of ragging with
            // their digit count.
            width: 34px * root.zoom;
            horizontal-alignment: right;
            vertical-alignment: center;
            text: root.item.detail;
            color: Theme.faint;
            font-size: 10px * root.zoom;
        }
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.item.text;
            color: Theme.text;
            font-size: 12px * root.zoom;
            overflow: elide;
        }
    }
}

// The whole body of a non-PTY pane: a breadcrumb header over the scrolling rows.
// `ListView` (not the hand-rolled Flickable the left panel uses) because a file
// viewer's model runs to thousands of rows and only a ListView instantiates the
// visible ones.
export component ViewPane inherits Rectangle {
    in property <[PaneViewRow]> rows;
    in property <string> title;
    in property <color> accent;
    // The selected row range, inclusive; -1/-1 for none. Decided Rust-side — this
    // view only paints it (see `viewpane::select_row`).
    in property <int> sel-lo;
    in property <int> sel-hi;
    // The pane's transient bottom-right message ("Copied 12 lines"). A PTY pane gets this
    // drawn by the terminal widget; a view pane covers that widget entirely, so without a
    // copy of it here a copy from a view pane would confirm itself to nobody.
    in property <string> toast;
    // The focused-pane zoom, in the same units the terminal uses: `PaneItem::font-px`,
    // which Ctrl/Cmd+= / +- / +0 move through `State::font_zoom` and which a workspace file
    // already persists as `fontSize`. Every pane has carried it all along; this view is
    // simply the half that now reads it.
    //
    // Divided by the DEFAULT rather than by the user's configured base, so the multiplier
    // here is the same number the zoom toast flashes in the corner ("114%") — one reading
    // for what the chord just did, not two.
    in property <length> font-px: 14px;
    // A pane that has never been told a size reports 0, not 14 — the default above only
    // applies when nothing binds the property at all. Reading that literally would collapse
    // every row to nothing, so an out-of-range value means "unzoomed" rather than "invisible".
    property <float> zoom: root.font-px < 1px ? 1.0 : root.font-px / 14px;
    // Reports the row INDEX; the controller resolves it against the same cached
    // projection it handed to this view.
    callback activate(int);
    // Row INDEX + whether shift was held.
    callback select(int, bool);
    // Reports a clicked markdown link by href. Not a row index: the row is a
    // paragraph and the link is one span inside it, so the index would not say
    // which.
    callback link-clicked(string);

    background: Theme.bg;

    VerticalLayout {
        // The breadcrumb: which path this pane is showing. The pane header above
        // already carries the pane's own label, so this is the target, not a title.
        Rectangle {
            height: 20px;
            background: Theme.mantle;
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                vertical-alignment: center;
                text: root.title;
                color: Theme.subtext;
                font-size: 10px;
                overflow: elide;
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Theme.border;
            }
        }

        ListView {
            vertical-stretch: 1;
            for it[i] in root.rows : ViewRowView {
                item: it;
                accent: root.accent;
                zoom: root.zoom;
                selected: root.sel-lo >= 0 && i >= root.sel-lo && i <= root.sel-hi;
                activate => { root.activate(i); }
                select(ext) => { root.select(i, ext); }
                link-clicked(l) => { root.link-clicked(l); }
            }
        }
    }

    if root.toast != "" : Rectangle {
        x: parent.width - self.width - 10px;
        y: parent.height - self.height - 10px;
        width: tt.width + 16px;
        height: 22px;
        background: Theme.surface2;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        tt := Text {
            // The pane's own confirmation — "Copied 12 lines". Auto-labelled as every
            // Text is, but that name was reaching nobody: the toast appears and fades
            // without focus ever moving to it, so unless it declares itself live there
            // is no moment at which anything would read it out.
            accessible-live-region: polite;
            x: 8px;
            y: 0;
            height: parent.height;
            text: root.toast;
            color: Theme.text;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}
