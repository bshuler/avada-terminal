// Edge-reveal drawer: a panel parked just off one edge of its parent that slides in when
// the pointer reaches that edge and slides away shortly after it leaves.
//
// Mount it as a child of the area it should overlay (the centre column — never the window
// root, or it would cover the side rails). It fills that area but draws and hit-tests only
// its own pieces, so everything else clicks straight through to the panes beneath.
//
// Focus: nothing here is a FocusScope and a TouchArea never takes keyboard focus, so typing
// in the terminal keeps working while a drawer is up. A control placed inside decides for
// itself whether a click moves focus (the bottom cards focus their pane).
//
// Timings are the Arcane spec's defaults: ~150ms before reveal, 200ms ease-out slide,
// ~300ms before hiding. A thin always-visible `lip` stays on the edge so a hidden drawer
// still shows that it exists (and `lip-color` / `lip-content` can say something is waiting).

import { Theme } from "theme.slint";

export component EdgeDrawer inherits Rectangle {
    in property <bool> at-top: true;
    in-out property <length> drawer-height: 120px;
    in property <length> lip: 3px;
    in property <length> hot-zone: 16px;
    in property <color> lip-color: Theme.arc-magenta;
    // Holds the drawer open while true (e.g. an unread needs-response item). It only stops
    // the drawer hiding; revealing is still the pointer's job.
    in property <bool> keep-open: false;
    out property <bool> open: false;
    // Parked in view with no hover needed (the default; auto-hide is the opt-in). The
    // reveal/hide timers still run, so `open`/`revealed` keep meaning "the pointer is here".
    in property <bool> pinned: false;
    // The drag handle on the inner edge. `resizing` is true while the button is held;
    // `resized` fires once on release so the owner persists the height.
    in-out property <bool> resizing: false;
    in property <length> min-h: 48px;
    in property <length> max-h: 280px;
    callback resized();
    property <bool> shown: root.pinned || root.open;
    // A pinned bar keeps only a hairline rule on its edge; the 3px lip is the auto-hide hint.
    property <length> eff-lip: root.pinned ? 1px : root.lip;
    // A count drawn on the lip when > 0 (the bottom drawer's needs-response badge).
    in property <int> lip-badge: 0;
    // Fired once the drawer has stayed open ~1.5s — long enough to have been read.
    callback revealed();

    property <bool> hovered: zone.has-hover || body.has-hover;

    // Reveal / hide delays. A Timer restarts each time `running` goes false → true, so a
    // pointer that merely grazes the edge (gone before 150ms) never opens the drawer.
    Timer {
        interval: 150ms;
        running: root.hovered && !root.open;
        triggered => { root.open = true; }
    }
    Timer {
        interval: 300ms;
        running: root.open && !root.hovered && !root.keep-open;
        triggered => { root.open = false; }
    }

    Timer {
        interval: 1500ms;
        running: root.open;
        triggered => { root.revealed(); }
    }

    // The edge hot zone. Declared before the panel so an open panel's cards sit above it.
    zone := TouchArea {
        x: 0;
        width: parent.width;
        height: root.hot-zone;
        y: root.at-top ? 0px : parent.height - self.height;
        mouse-cursor: default;
    }

    panel := Rectangle {
        x: 0;
        width: parent.width;
        height: root.drawer-height;
        y: root.at-top
            ? (root.shown ? 0px : root.eff-lip - self.height)
            : (root.shown ? parent.height - self.height : parent.height - root.eff-lip);
        animate y { duration: 200ms; easing: ease-out; }
        background: Theme.arc-bar;
        // A shorter bar must not let its contents spill over the terminal below it.
        clip: true;

        // Swallows pointer events over the panel so a click on the drawer never reaches the
        // terminal underneath, and holds the drawer open while the pointer is anywhere on it.
        // Everything in the panel is nested *inside* this TouchArea on purpose: Slint keeps
        // `has-hover` on every TouchArea along the path to the item under the pointer, so a
        // card with its own TouchArea still counts as "on the drawer". As a sibling, the
        // card's TouchArea took the hover and the drawer timed out under a resting pointer.
        body := TouchArea {
            width: 100%;
            height: 100%;

            @children

            // The lip: the always-visible sliver on the screen-side edge of the panel.
            Rectangle {
                y: root.at-top ? parent.height - root.eff-lip : 0px;
                height: root.eff-lip;
                background: root.lip-color;
            }

            // Resize handle: a 6px strip over the inner edge (and the lip). Only live while
            // the bar is in view. Heights come from the pointer's window position, not
            // `mouse-y`, because the handle itself moves as the bar resizes.
            grip := TouchArea {
                property <length> start-y;
                property <length> start-h;
                x: 0;
                width: parent.width;
                height: 6px;
                y: root.at-top ? parent.height - self.height : 0px;
                enabled: root.shown;
                mouse-cursor: root.shown ? MouseCursor.ns-resize : MouseCursor.default;
                accessible-role: slider;
                accessible-label: root.at-top ? "Resize the top bar" : "Resize the bottom bar";
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        self.start-y = self.absolute-position.y + self.mouse-y;
                        self.start-h = root.drawer-height;
                        root.resizing = true;
                    } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                        if (root.resizing) {
                            root.resizing = false;
                            root.resized();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        let dy = self.absolute-position.y + self.mouse-y - self.start-y;
                        root.drawer-height = clamp(self.start-h + (root.at-top ? dy : -dy),
                            root.min-h, root.max-h);
                    }
                }
                Rectangle {
                    y: root.at-top ? parent.height - self.height : 0px;
                    height: 2px;
                    background: (grip.has-hover || grip.pressed) ? Theme.arc-gold.with-alpha(0.8) : transparent;
                }
            }

            // Count badge: hangs off the lip into the strip that stays visible when closed? The
            // lip is only a few px tall, so the badge sits on the panel's inner corner and shows
            // whenever the drawer is open; closed, the lip's colour alone signals "waiting".
            if root.lip-badge > 0 : Rectangle {
                x: parent.width - self.width - 14px;
                y: root.at-top ? 8px : 8px;
                width: 22px;
                height: 18px;
                border-radius: 9px;
                background: Theme.warn;
                Text {
                    text: root.lip-badge;
                    color: Theme.arc-bg;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
